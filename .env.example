# ก็อปไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ถ้าใช้ Supabase: Project Settings > Database > Connection string (URI)
# ถ้าใช้ Neon: Dashboard > Connection Details
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth — generate secret ด้วยคำสั่ง: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Stripe — เอาจาก https://dashboard.stripe.com/test/apikeys (ใช้ test mode ก่อน)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..." # ได้จาก `stripe listen` ตอน dev หรือจาก Stripe dashboard ตอน deploy จริง

# URL ของแอป ใช้สร้าง success/cancel redirect หลังจ่ายเงิน
NEXT_PUBLIC_APP_URL="http://localhost:3000"
